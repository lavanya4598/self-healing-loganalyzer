OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-flash-latest
LLM_PROVIDER=google
JWT_SECRET=change_this_to_a_strong_random_secret

# AI service (Node.js, calls Gemini directly - no Python/pip/Docker required)
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_PORT=8001

# ChromaDB mode: "embedded" runs locally with no server/Docker required (default).
# Use "http" only if you deliberately run a separate Chroma server.
CHROMA_MODE=embedded

# ─── Self-healing auto-execution (OFF by default) ──────────────────────────
# When enabled, the backend will automatically SSH into a target host below
# and run a FIXED, pre-approved command for certain action types - it never
# executes anything the AI/LLM invented. rotate_credentials can NEVER be
# auto-executed, no matter what, and always requires manual approval.
# Leave SELF_HEALING_ENABLED=false unless you understand the implications of
# letting this app run commands on a real server unattended.
SELF_HEALING_ENABLED=false

# ── Default target (single-VM setup) ───────────────────────────────────────
SELF_HEAL_SSH_HOST=
SELF_HEAL_SSH_PORT=22
SELF_HEAL_SSH_USER=
# Prefer a private key over a password:
SELF_HEAL_SSH_PRIVATE_KEY_PATH=
SELF_HEAL_SSH_PASSPHRASE=
SELF_HEAL_SSH_PASSWORD=

# ── Multiple targets (e.g. 2 local CentOS VMs in VMware Workstation) ───────
# List extra named targets here, then set the same set of vars per target
# with a _<NAME> suffix (uppercased). "default" above always exists; add as
# many named targets as you have VMs. At log-upload/ingest time, set
# `target_host` (e.g. "vm1" or "vm2") to route an anomaly's healing action
# to the right VM - unset/unknown values fall back to "default".
SELF_HEAL_TARGETS=vm1,vm2

SELF_HEAL_SSH_HOST_VM1=192.168.x.101
SELF_HEAL_SSH_PORT_VM1=22
SELF_HEAL_SSH_USER_VM1=centos
SELF_HEAL_SSH_PRIVATE_KEY_PATH_VM1=
SELF_HEAL_SSH_PASSWORD_VM1=

SELF_HEAL_SSH_HOST_VM2=192.168.x.102
SELF_HEAL_SSH_PORT_VM2=22
SELF_HEAL_SSH_USER_VM2=centos
SELF_HEAL_SSH_PRIVATE_KEY_PATH_VM2=
SELF_HEAL_SSH_PASSWORD_VM2=

# Optional per-action-type command overrides (only these action types run
# automatically; anything unset here falls back to the manual approval flow).
# The SAME command is used regardless of which target VM is picked - only
# the destination host changes, not the command:
# SELF_HEAL_CMD_RESTART_SERVICE=sudo systemctl restart myapp
# SELF_HEAL_CMD_CLEAR_CACHE=sudo systemctl restart myapp-cache
# SELF_HEAL_CMD_DISK_CLEANUP=sudo journalctl --vacuum-time=3d
# SELF_HEAL_CMD_NETWORK_RESET=sudo systemctl restart networking
# SELF_HEAL_CMD_CONFIG_UPDATE=
# SELF_HEAL_CMD_ROLLBACK_DEPLOYMENT=
# SELF_HEAL_CMD_SCALE_UP=
# SELF_HEAL_CMD_AUTO_FIX_CODE=
#
# For action types with no fixed command configured, an approver (team
# lead/manager/admin) can still type an exact command to run on the chosen
# target VM via the "Manual Command" addon in the Approvals UI - this is a
# human-authored one-off command, never anything the LLM suggested.

