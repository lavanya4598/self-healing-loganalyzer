OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=AQ.Ab8RN6Lyw8PQXF74IeQbeOHKF0aISqsx3ctatDqhVwDn_WORug
GOOGLE_MODEL=gemini-flash-latest
LLM_PROVIDER=google
JWT_SECRET=change_this_to_a_strong_random_secret

# AI service (Node.js, calls Gemini directly - no Python/pip/Docker required)
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_PORT=8001

# ChromaDB mode: "embedded" runs locally with no server/Docker required (default).
# Use "http" only if you deliberately run a separate Chroma server.
CHROMA_MODE=embedded

# ─── Self-healing auto-execution (OFF by default) ──────────────────────────
# Set to true and fill in the SSH details below to let the backend actually
# SSH into a target host and run a FIXED command for certain action types.
# rotate_credentials is never auto-executed regardless of this setting.
SELF_HEALING_ENABLED=true
SELF_HEAL_SSH_HOST=
SELF_HEAL_SSH_PORT=22
SELF_HEAL_SSH_USER=
SELF_HEAL_SSH_PRIVATE_KEY_PATH=
SELF_HEAL_SSH_PASSPHRASE=
SELF_HEAL_SSH_PASSWORD=

# ── Multiple targets (2 local CentOS VMs in VMware Workstation) ───────────
# Fill these in and set target_host="host1"/"host2" at log upload/ingest time
# to route healing actions to the right VM. See .env.example for full docs.
SELF_HEAL_TARGETS=host1,host2
SELF_HEAL_SSH_HOST_HOST1=192.168.152.128
SELF_HEAL_SSH_PORT_HOST1=22
SELF_HEAL_SSH_USER_HOST1=root
# Fill in the password yourself directly here (never share it in chat):
SELF_HEAL_SSH_PASSWORD_HOST1=linux123
SELF_HEAL_SSH_HOST_HOST2=192.168.152.129
SELF_HEAL_SSH_PORT_HOST2=22
SELF_HEAL_SSH_USER_HOST2=root
# Fill in the password yourself directly here (never share it in chat):
SELF_HEAL_SSH_PASSWORD_HOST2=linux123

# ─── Automatic log collection (OFF by default) ─────────────────────────────
# When enabled, the backend polls each configured target above (host1,
# host2) on an interval, pulling recent system logs (journalctl) and running
# them through the same analysis/approval/healing pipeline as a manual
# upload. Read-only on the VM - never runs anything derived from log content.
LOG_COLLECTION_ENABLED=true
LOG_COLLECTION_INTERVAL_SECONDS=60
LOG_COLLECTION_LINES=200
LOG_COLLECTION_ENVIRONMENT=production

# ─── Service health monitoring (OFF by default) ────────────────────────────
# Periodically checks the listed systemd services on every target above via
# `systemctl is-active` (read-only). If one goes down, an approval-gated
# healing action is raised with an LLM-suggested restart command - shown to
# the approver, never auto-executed. Add your own services here (comma list;
# sshd is included since it's always running if SSH access works at all).
SERVICE_MONITORING_ENABLED=true
SERVICE_MONITOR_INTERVAL_SECONDS=60
MONITORED_SERVICES=sshd
# Per-target override: all services currently running on each VM.
MONITORED_SERVICES_HOST1=atd,auditd,chronyd,crond,dbus-broker,firewalld,getty@tty1,httpd,libstoragemgmt,mcelog,NetworkManager,polkit,postfix,rsyslog,sshd,systemd-journald,systemd-logind,systemd-udevd,systemd-userdbd,tuned,user@0,vgauthd,vmtoolsd
MONITORED_SERVICES_HOST2=atd,auditd,chronyd,crond,dbus-broker,firewalld,getty@tty1,httpd,libstoragemgmt,mcelog,NetworkManager,polkit,postfix,rsyslog,sshd,systemd-journald,systemd-logind,systemd-udevd,systemd-userdbd,tuned,user@0,vgauthd,vmtoolsd

# Optional per-action-type command overrides (unset ones fall back to manual approval):
# SELF_HEAL_CMD_RESTART_SERVICE=sudo systemctl restart myapp
# SELF_HEAL_CMD_CLEAR_CACHE=sudo systemctl restart myapp-cache
# SELF_HEAL_CMD_DISK_CLEANUP=sudo journalctl --vacuum-time=3d
# SELF_HEAL_CMD_NETWORK_RESET=sudo systemctl restart networking

